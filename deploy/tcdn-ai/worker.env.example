# TCDN-AI worker configuration (copy to worker.env, chmod 600, never commit).
# Required
TCDN_AI_COORDINATOR_URL=https://api.torrentcdn.store
TCDN_AI_WORKER_API_KEY=tcdn_ai_REPLACE_WITH_A_WORKER_SCOPE_KEY
# model_id=manifest_sha256, comma-separated. Hashes must be the SHA-256 of the
# signed manifest the coordinator published.
TCDN_AI_WORKER_MODELS=llama-3.1-8b-instruct=REPLACE_WITH_64_HEX
TCDN_AI_BACKEND=ollama            # ollama | vllm | echo (dev only)
TCDN_AI_IDENTITY_FILE=/var/lib/tcdn-ai/worker-identity.json

# Reported in the registry (operators should not exaggerate these)
TCDN_AI_GPU_MODEL=NVIDIA L4
TCDN_AI_GPU_VRAM_GB=24
TCDN_AI_REGION=eu-west
TCDN_AI_PRICE_MICRO_PER_MTOK=1500000

# Confidential tier: only set "attested-tee" when the worker actually runs in an
# attested confidential VM with GPU CC mode, and set TCDN_AI_WORKER_ATTESTED=true
# only after the coordinator issued a verified verdict. A worker that claims the
# tier without attestation refuses confidential tickets.
TCDN_AI_WORKER_CONFIDENTIALITY=none
TCDN_AI_WORKER_ATTESTED=false

# Engine URLs (loopback only — the worker refuses remote engine URLs)
TCDN_AI_VLLM_URL=http://127.0.0.1:8000
TCDN_AI_OLLAMA_URL=http://127.0.0.1:11434
