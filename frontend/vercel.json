{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://www.torrentcdn.store"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://torrent-cdn.onrender.com/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://torrent-cdn.onrender.com/auth/$1"
    },
    {
      "source": "/upload",
      "destination": "https://torrent-cdn.onrender.com/upload"
    },
    {
      "source": "/upload/(.*)",
      "destination": "https://torrent-cdn.onrender.com/upload/$1"
    },
    {
      "source": "/files",
      "destination": "https://torrent-cdn.onrender.com/files"
    },
    {
      "source": "/files/(.*)",
      "destination": "https://torrent-cdn.onrender.com/files/$1"
    },
    {
      "source": "/analytics/(.*)",
      "destination": "https://torrent-cdn.onrender.com/analytics/$1"
    },
    {
      "source": "/billing/(.*)",
      "destination": "https://torrent-cdn.onrender.com/billing/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://torrent-cdn.onrender.com/admin/$1"
    },
    {
      "source": "/notifications",
      "destination": "https://torrent-cdn.onrender.com/notifications"
    },
    {
      "source": "/notifications/(.*)",
      "destination": "https://torrent-cdn.onrender.com/notifications/$1"
    }
  ]
}
