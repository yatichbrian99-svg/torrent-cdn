{
  "name": "torrent-cdn-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure_webtorrent_patch.js && next build && node scripts/check_webtorrent_patch.js",
    "start": "next start",
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:e2e": "node e2e/run-all.mjs",
    "test:e2e:upload": "node e2e/upload-direct.mjs",
    "test:e2e:fallback": "node e2e/upload-fallback.mjs",
    "test:e2e:embed": "node e2e/embed-playback.mjs",
    "test:e2e:autoseed": "node e2e/auto-seed.mjs",
    "test:e2e:p2p": "node e2e/p2p-two-peer.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stripe/stripe-js": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "axios": "^1.19.0",
    "lucide-react": "^1.28.0",
    "next": "15.5.21",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^3",
    "typescript": "^5",
    "webtorrent": "^2.1.0"
  },
  "overrides": {
    "postcss": "^8.5.6",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.61.0",
    "vitest": "^4.1.10"
  }
}
