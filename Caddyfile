# ── Site Address ──
# For local dev: SITE_ADDR=http://localhost (default, plain HTTP, no redirect)
# For production: SITE_ADDR=example.com (no scheme = Caddy auto-HTTPS)
{$SITE_ADDR:-http://localhost} {
    # ── API proxy ──
    # Strips /api prefix before forwarding to backend
    # e.g. /api/auth/register → /auth/register
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # ── Health check ──
    # Also proxy /health to backend so it's accessible through Caddy
    handle /health {
        reverse_proxy backend:8000
    }

    # ── Frontend (falls through after /api/* and /health) ──
    handle {
        reverse_proxy frontend:3000
    }

    # ── Security headers (Caddy-native, complement backend headers) ──
    header {
        # Already set by backend, but ensure they're present even if backend is down
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"

        # HSTS — 1 year, include subdomains, preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Block all Permissions-Policy at proxy level
        Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    }

    # ── Logs ──
    log {
        output file /data/logs/access.log
        format json
    }
}
