# Database
DATABASE_URL=postgresql://user:password@postgres:5432/torrentcdn

# Redis
REDIS_URL=redis://redis:6379

# S3-compatible object storage. The whole app is provider-agnostic: MinIO
# (local), Supabase Storage, Cloudflare R2, or Backblaze B2 all work via these
# env vars — no code changes needed.
#
# Local/MinIO:        MINIO_ENDPOINT=minio:9000, SECURE=false, PUBLIC_URL=http://localhost:9000/torrent-cdn-files
# Supabase Storage:   endpoint=<project>.supabase.co/storage/v1/s3, SECURE=true,
#                     PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/<bucket>
#                     NOTE: free tier hard-caps files at 50MB (plan limit).
# Cloudflare R2:      endpoint=<account_id>.r2.cloudflarestorage.com, SECURE=true, REGION=auto,
#                     PUBLIC_URL=https://cdn.yourdomain.com (custom domain → bucket)
#                     no per-file cap (up to 5TB), $0 egress.
# Backblaze B2:       endpoint=s3.us-west-004.backblazeb2.com, SECURE=true, REGION=us-west-004,
#                     PUBLIC_URL=https://<bucket>.<endpoint>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=torrent-cdn-files
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000/torrent-cdn-files
MINIO_REGION=us-east-1

# JWT
JWT_SECRET=changeme

# Resend (transactional email — free tier 100 emails/day)
RESEND_API_KEY=

# Two-factor authentication (TOTP, stdlib)
# Lifetime of the password-half MFA token minted at login (minutes).
MFA_EXPIRE_MINUTES=5
# Require 2FA for EVERY account: login refuses to mint a session until the
# user scans the authenticator QR and verifies a code (enrollment happens at
# login via /auth/mfa/setup + /auth/mfa/confirm). Enabled by default in
# production; set MFA_REQUIRED=false to make 2FA optional again.
# MFA_REQUIRED=true

# Referral program: LIFETIME cap (GB) on the bonus a single referrer can earn
# (+10GB per successful referral, clamped at this total — farming many accounts
# against one code can no longer grant unlimited free bandwidth).
REFERRAL_BONUS_CAP_GB=100

# Opt-in malware scanning via VirusTotal (see backend/app/malware_scan.py).
# Leave empty to keep uploads magic-byte-only (feature off, fail-open).
# Free tier: 500 lookups/day; file uploads capped at VIRUSTOTAL_MAX_UPLOAD_MB.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_MAX_UPLOAD_MB=32

# Paystack (Kenya — Stripe does not support Kenyan merchant accounts)
# Create recurring plans in the Paystack dashboard (Products & plans) and paste
# the PLN_... codes here. Amounts are in the smallest currency unit (KES cents):
# 400000 = KES 4,000/month. The same secret key signs API calls AND webhooks.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CURRENCY=KES
PAYSTACK_PLAN_PRO=PLN_pro_monthly
PAYSTACK_PLAN_BUSINESS=PLN_business_monthly
PAYSTACK_AMOUNT_PRO=400000
PAYSTACK_AMOUNT_BUSINESS=1200000

# Admin bootstrap (see SECURITY.md). ADMIN_SETUP_ENABLED=true + a call to
# POST /auth/setup (with the token in the X-Admin-Setup-Token HEADER — never a
# query param, which access logs capture) creates the first admin; ALWAYS set
# ADMIN_SETUP_TOKEN too (a random value) so a flag left on can't be abused by
# any authenticated user.
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_TOKEN=

# ── Live streaming (MediaMTX integration) ──────────────────────────────────
# MediaMTX Control API — INTERNAL ONLY (never expose port 9997/9998 publicly).
# In docker-compose the backend reaches MediaMTX over the internal network.
MEDIAMTX_API_URL=http://mediamtx:9997
# Public RTMP ingest URL handed to OBS users (server URL, without stream key).
# Local dev: rtmp://localhost:1935  ·  Production: rtmp://stream.example.com:1935
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
# Public HLS base URL for playback URLs minted by the API.
# Local dev: http://localhost:8888 (or http://localhost/hls behind Caddy)
# Production: https://stream.example.com/hls
MEDIAMTX_HLS_URL=http://localhost:8888
# Optional public WebRTC base URL (future WHEP playback; leave empty if unused).
MEDIAMTX_WEBRTC_URL=
# Shared secret MediaMTX→backend auth hook (MEDIAMTX_AUTH_URL carries it).
# Generate: openssl rand -hex 32
MEDIAMTX_HOOK_SECRET=changeme-generate-a-random-32-byte-hex
# HLS segment sizing (MUST match deploy/mediamtx/mediamtx.yml — the backend
# uses the duration for live-edge math and segment expiry).
LIVE_HLS_SEGMENT_DURATION=2
LIVE_HLS_PART_DURATION=0.7
# Signing secret for short-lived playback tokens. Optional: derives from
# JWT_SECRET when unset. Set explicitly in production so rotating JWT_SECRET
# doesn't invalidate every active playback token.
PLAYBACK_TOKEN_SECRET=
# Public playback domain for signed HLS URLs (defaults to MEDIAMTX_HLS_URL).
PUBLIC_PLAYBACK_DOMAIN=
# Live tuning: heartbeat cadence, peer death timer, monitor cadence, and how
# long a segment stays tracked after leaving the live window (keep >= 3x the
# segment duration so stragglers can still be served by peers).
LIVE_HEARTBEAT_INTERVAL_SECONDS=5
LIVE_PEER_TIMEOUT_SECONDS=15
LIVE_MONITOR_INTERVAL_SECONDS=5
LIVE_SEGMENT_RETENTION_SECONDS=30
LIVE_MAX_SEGMENT_AGE_SECONDS=12
LIVE_TOKEN_RATE_LIMIT=240

# Global burst limiter (requests per 10s per IP). Sensitive endpoints carry
# their own dedicated limiters; this is only a gross-burst backstop. Keep high
# enough that users behind shared NAT/office IPs never see 429s (a dashboard
# load fires ~7 calls).
RATE_LIMIT_GLOBAL=300

# App
APP_URL=http://localhost:3000

# Scaling (production): gunicorn worker count (the Dockerfile reads
# WEB_CONCURRENCY; 1 is right for Render free tier's 0.1 CPU) and the
# per-worker asyncpg pool. On a bigger plan raise WEB_CONCURRENCY — upload
# sessions are Redis-backed, so they survive across workers. Keep
# workers * DB_POOL_MAX_SIZE under the Supabase pooler connection cap
# (free tier ~60). DB_POOL_ACQUIRE_TIMEOUT bounds pool-wait under saturation
# (returns a retryable 503 instead of hanging requests).
WEB_CONCURRENCY=1
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT=10

# Trusted reverse proxies that set X-Forwarded-For for proxied traffic.
# Comma-separated IPs and/or CIDRs. When set, per-IP rate limits only trust
# XFF from these peers — a client connecting directly to the backend can no
# longer forge the header to rotate past login/register/upload limits. Empty
# (default): legacy first-XFF behavior + a production startup warning.
#
# Production (render.yaml) uses Cloudflare's published ranges (the direct peer
# — Render routes onrender.com through Cloudflare) + Vercel's ARIN netblocks
# (the vercel.json rewrite proxy): refresh from
# https://www.cloudflare.com/ips-v4 + ips-v6 if the startup warning returns.
TRUSTED_PROXIES=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
