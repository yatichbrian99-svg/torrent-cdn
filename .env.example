# Database
DATABASE_URL=postgresql://user:password@postgres:5432/torrentcdn

# Redis
REDIS_URL=redis://redis:6379

# S3-compatible object storage. The whole app is provider-agnostic: MinIO
# (local), Supabase Storage, Cloudflare R2, or Backblaze B2 all work via these
# env vars — no code changes needed.
#
# Local/MinIO:        MINIO_ENDPOINT=minio:9000, SECURE=false, PUBLIC_URL=http://localhost:9000/torrent-cdn-files
# Supabase Storage:   endpoint=<project>.supabase.co/storage/v1/s3, SECURE=true,
#                     PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/<bucket>
#                     NOTE: free tier hard-caps files at 50MB (plan limit).
# Cloudflare R2:      endpoint=<account_id>.r2.cloudflarestorage.com, SECURE=true, REGION=auto,
#                     PUBLIC_URL=https://cdn.yourdomain.com (custom domain → bucket)
#                     no per-file cap (up to 5TB), $0 egress.
# Backblaze B2:       endpoint=s3.us-west-004.backblazeb2.com, SECURE=true, REGION=us-west-004,
#                     PUBLIC_URL=https://<bucket>.<endpoint>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=torrent-cdn-files
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000/torrent-cdn-files
MINIO_REGION=us-east-1

# JWT
JWT_SECRET=changeme

# Resend (transactional email — free tier 100 emails/day)
RESEND_API_KEY=
# Sender for verification / password-reset / MFA / welcome mail. Any local part
# on the Resend-verified domain works; keep it distinct from the human
# mailboxes (hello@, yatich@) so system mail is never mistaken for a person.
RESEND_FROM=TorrentCDN <notifications@torrentcdn.store>

# Two-factor authentication (TOTP, stdlib)
# Lifetime of the password-half MFA token minted at login (minutes).
MFA_EXPIRE_MINUTES=5
# Require 2FA for EVERY account: login refuses to mint a session until the
# user scans the authenticator QR and verifies a code (enrollment happens at
# login via /auth/mfa/setup + /auth/mfa/confirm). Enabled by default in
# production; set MFA_REQUIRED=false to make 2FA optional again.
# MFA_REQUIRED=true

# Referral program: LIFETIME cap (GB) on the bonus a single referrer can earn
# (+10GB per successful referral, clamped at this total — farming many accounts
# against one code can no longer grant unlimited free bandwidth).
REFERRAL_BONUS_CAP_GB=100

# Opt-in malware scanning via VirusTotal (see backend/app/malware_scan.py).
# Leave empty to keep uploads magic-byte-only (feature off, fail-open).
# Free tier: 500 lookups/day; file uploads capped at VIRUSTOTAL_MAX_UPLOAD_MB.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_MAX_UPLOAD_MB=32

# Paystack (Kenya — Stripe does not support Kenyan merchant accounts)
# Create recurring plans in the Paystack dashboard (Products & plans) and paste
# the PLN_... codes here. Amounts are in the smallest currency unit (KES cents):
# 400000 = KES 4,000/month. The same secret key signs API calls AND webhooks.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CURRENCY=KES
PAYSTACK_PLAN_PRO=PLN_pro_monthly
PAYSTACK_PLAN_BUSINESS=PLN_business_monthly
PAYSTACK_AMOUNT_PRO=400000
PAYSTACK_AMOUNT_BUSINESS=1200000

# Admin bootstrap (see SECURITY.md). ADMIN_SETUP_ENABLED=true + a call to
# POST /auth/setup (with the token in the X-Admin-Setup-Token HEADER — never a
# query param, which access logs capture) creates the first admin; ALWAYS set
# ADMIN_SETUP_TOKEN too (a random value) so a flag left on can't be abused by
# any authenticated user.
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_TOKEN=

# ── Live streaming (MediaMTX integration) ──────────────────────────────────
# MediaMTX Control API — INTERNAL ONLY (never expose port 9997/9998 publicly).
# In docker-compose the backend reaches MediaMTX over the internal network.
MEDIAMTX_API_URL=http://mediamtx:9997
# Public RTMP ingest URL handed to OBS users (server URL, without stream key).
# Local dev: rtmp://localhost:1935  ·  Production: rtmp://stream.example.com:1935
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
# Public HLS base URL for playback URLs minted by the API.
# Local dev: http://localhost:8888 (or http://localhost/hls behind Caddy)
# Production: https://stream.example.com/hls
MEDIAMTX_HLS_URL=http://localhost:8888
# Optional public WebRTC base URL (future WHEP playback; leave empty if unused).
MEDIAMTX_WEBRTC_URL=
# Shared secret MediaMTX→backend auth hook (MEDIAMTX_AUTH_URL carries it).
# Generate: openssl rand -hex 32
MEDIAMTX_HOOK_SECRET=changeme-generate-a-random-32-byte-hex
# Instant publisher confirmation: MediaMTX runOnReady/runOnNotReady hooks
# POST to the backend the moment a stream goes ready/offline (status flips
# LIVE/OFFLINE in ~1s instead of the monitor's poll interval). Enabled by
# default in docker compose (built from deploy/mediamtx/Dockerfile, which
# adds the busybox shell the distroless image lacks).
# HLS segment sizing (MUST match deploy/mediamtx/mediamtx.yml — the backend
# uses the duration for live-edge math and segment expiry).
LIVE_HLS_SEGMENT_DURATION=2
LIVE_HLS_PART_DURATION=0.7
# Signing secret for short-lived playback tokens. Optional: derives from
# JWT_SECRET when unset. Set explicitly in production so rotating JWT_SECRET
# doesn't invalidate every active playback token.
PLAYBACK_TOKEN_SECRET=
# Public playback domain for signed HLS URLs (defaults to MEDIAMTX_HLS_URL).
PUBLIC_PLAYBACK_DOMAIN=
# Live tuning: heartbeat cadence, peer death timer, monitor cadence, and how
# long a segment stays tracked after leaving the live window (keep >= 3x the
# segment duration so stragglers can still be served by peers).
LIVE_HEARTBEAT_INTERVAL_SECONDS=5
LIVE_PEER_TIMEOUT_SECONDS=15
LIVE_MONITOR_INTERVAL_SECONDS=5
LIVE_SEGMENT_RETENTION_SECONDS=30
LIVE_MAX_SEGMENT_AGE_SECONDS=12
LIVE_TOKEN_RATE_LIMIT=240

# Global burst limiter (requests per 10s per IP). Sensitive endpoints carry
# their own dedicated limiters; this is only a gross-burst backstop. Keep high
# enough that users behind shared NAT/office IPs never see 429s (a dashboard
# load fires ~7 calls).
RATE_LIMIT_GLOBAL=300

# App
APP_URL=http://localhost:3000

# Scaling (production): gunicorn worker count (the Dockerfile reads
# WEB_CONCURRENCY; 1 is right for Render free tier's 0.1 CPU) and the
# per-worker asyncpg pool. On a bigger plan raise WEB_CONCURRENCY — upload
# sessions are Redis-backed, so they survive across workers. Keep
# workers * DB_POOL_MAX_SIZE under the Supabase pooler connection cap
# (free tier ~60). DB_POOL_ACQUIRE_TIMEOUT bounds pool-wait under saturation
# (returns a retryable 503 instead of hanging requests).
WEB_CONCURRENCY=1
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT=10

# Trusted reverse proxies that set X-Forwarded-For for proxied traffic.
# Comma-separated IPs and/or CIDRs. When set, per-IP rate limits only trust
# XFF from these peers — a client connecting directly to the backend can no
# longer forge the header to rotate past login/register/upload limits. Empty
# (default): legacy first-XFF behavior + a production startup warning.
#
# Production (render.yaml) uses Cloudflare's published ranges (the direct peer
# — Render routes onrender.com through Cloudflare) + Vercel's ARIN netblocks
# (the vercel.json rewrite proxy): refresh from
# https://www.cloudflare.com/ips-v4 + ips-v6 if the startup warning returns.
TRUSTED_PROXIES=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Option A: permanent public live URLs (edge profile) ──────────────────
# Only needed on the operator machine running the edge DDNS service
# (docker compose --profile edge up -d ddns). One-time setup and
# verification commands: deploy/ddns/README.md
NAMECHEAP_DDNS_PASSWORD=
DDNS_DOMAIN=torrentcdn.store
DDNS_HOSTS=rtmp,hls
# Rebind MediaMTX RTMP to all interfaces so the router port-forward reaches it
MEDIAMTX_RTMP_BIND=0.0.0.0

# ── Same-origin proxy authentication (production) ─────────────────────────
# The frontend middleware stamps this secret on every request it proxies to
# the backend; the backend then trusts the client IP for rate limiting.
# MUST be the same long random value on BOTH services (Vercel + backend).
# Leave empty in dev (middleware proxy no-ops without BACKEND_ORIGIN).
EDGE_PROXY_AUTH=
# Frontend only: where the middleware proxies API paths (prod backend URL)
BACKEND_ORIGIN=

# ── Vercel (frontend) build env — set in vercel.json / Vercel dashboard ─────
# NEXT_PUBLIC_LIVE_HLS_ORIGIN=https://hls.torrentcdn.store
#   Baked into the frontend bundle at build time; feeds the page CSP
#   connect-src so hls.js may fetch playlists/segments from the live edge.
#   See deploy/oracle/README.md (step 4) before cutting over production.

# ── TCDN-AI (docs/tcdn-ai/) ─────────────────────────────────────────────────
# The AI module is gated by ENABLE_TCDN_AI (NOT by TCDN_AI_ENABLED). The flag
# defaults to OFF, so a deployment without any TCDN_AI_ variables can still run
# the CDN backend.
#
# When ENABLE_TCDN_AI is on AND APP_ENV=production, the host app also refuses to
# enable the AI routes unless the AI environment is actually configured:
#   - TCDN_AI_ENVIRONMENT must be "production" (not absent / not development)
#   - at least one coordinator secret source must be present
#     (TCDN_AI_COORDINATOR_KEY_FILE or TCDN_AI_COORDINATOR_KEYRING_JSON or
#      TCDN_AI_API_KEY_PEPPER).
#
# When those are missing, AI_TABLES_DDL and /api/ai/v1 stay off rather than
# silently falling back to development defaults.
#
# In development, ENABLE_TCDN_AI=true with TCDN_AI_ENVIRONMENT=development and
# no pepper is fine; the coordinator generates an ephemeral in-memory keyring
# and logs that it did so.
#
# development | staging | production
ENABLE_TCDN_AI=false
TCDN_AI_ENVIRONMENT=development
# 70/10/20 must sum to exactly 100.
TCDN_AI_COMPUTE_SHARE_PCT=70
TCDN_AI_SEEDER_SHARE_PCT=10
TCDN_AI_PLATFORM_SHARE_PCT=20
# 0600 JSON keyring file (see docs/tcdn-ai/RUNBOOK.md). Production needs either
# this or the injected JSON below; in development an ephemeral in-memory keyring
# is generated and logged as such.
TCDN_AI_COORDINATOR_KEY_FILE=
# Alternative: the complete keyring JSON injected by a platform secret manager
# at runtime (read-only, never written back).
TCDN_AI_COORDINATOR_KEYRING_JSON=
TCDN_AI_KEY_OVERLAP_SECONDS=3600
TCDN_AI_TICKET_TTL_SECONDS=120
# 256-bit secret used as the API-key HMAC pepper. Required in production.
TCDN_AI_API_KEY_PEPPER=
TCDN_AI_API_KEY_PEPPER_ID=v1
# Billing: fake is development-only. Production uses Paystack (USD webhooks).
TCDN_AI_PAYMENT_PROVIDER=fake
TCDN_AI_PAYSTACK_SECRET_KEY=
TCDN_AI_SIGNUP_CREDITS=500
TCDN_AI_CONFIDENTIAL_UPLIFT_PCT=25
TCDN_AI_LAUNCH_PRICING_UNTIL=2027-04-01
# Limits
TCDN_AI_MAX_TOKENS_PER_REQUEST=4096
TCDN_AI_MAX_MESSAGES=64
TCDN_AI_MAX_BODY_BYTES=262144
TCDN_AI_RATE_LIMIT_PER_MINUTE=120
TCDN_AI_RATE_LIMIT_BURST=30
# Confidential tier: simulated attestation is dev-only.
TCDN_AI_ALLOW_SIMULATED_ATTESTATION=true
TCDN_AI_ALLOW_DEV_STUB_BACKEND=true
# $TCDN buy-and-burn is disabled and dry-run only; enabling it in production
# requires an explicit legal/tax acknowledgement.
TCDN_AI_ENABLE_TCDN_BURN=false
TCDN_AI_BURN_LEGAL_REVIEW_ACK=false
# Billing authority. In gateway mode the coordinator's own gateway holds the
# plaintext completion, so it counts the tokens it delivered instead of trusting
# the worker's receipt. When the two disagree by more than this percentage the
# LOWER count is billed and the node is flagged (the receipt is still authority
# when no measurement exists: SDK mode, or a job no gateway handled).
TCDN_AI_GATEWAY_BILLING_AUTHORITY=true
TCDN_AI_GATEWAY_TOKEN_TOLERANCE_PCT=25
# Per-node review: at least this many settled jobs, and receipts that billed above
# the gateway's count in more than this share of them, suspends the node and
# holds its pending payouts until an operator clears it.
TCDN_AI_NODE_OVERCLAIM_RATE_PCT=25
TCDN_AI_NODE_OVERCLAIM_MIN_SAMPLES=5
# Result verification (Part 3). Workers keep encrypted per-token records for the
# challenge window, then wipe them. Receipts carry only the Merkle root.
TCDN_AI_TRANSCRIPT_RETENTION_SECONDS=86400
# 3 % of gateway-mode jobs are re-executed on a different operator. The bucket is
# keyed (HMAC-SHA-256), so a worker cannot predict it from the job id.
TCDN_AI_VERIFICATION_SAMPLE_PCT=3
TCDN_AI_VERIFICATION_DAILY_CAP=500
# Ceiling on what one shadow execution can earn (micro-credits, 5 credits here).
TCDN_AI_VERIFICATION_PAYOUT_CAP_MICRO=5000000
# Optional dedicated sampling key. Unset, the API-key pepper is used; either way
# the key stays inside the coordinator.
TCDN_AI_VERIFICATION_SAMPLE_KEY=
